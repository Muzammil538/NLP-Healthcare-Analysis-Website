# Environment Variables
# WARNING: Never commit actual secret keys to version control!
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Flask secret key for session encryption
SECRET_KEY=generate_with_secrets.token_urlsafe_32

# JWT secret key for token generation
JWT_SECRET_KEY=generate_with_secrets.token_urlsafe_32

# Database configuration
SQLALCHEMY_DATABASE_URI=sqlite:///database.db

# For production, use environment-specific values instead of defaults
# Example for production (Postgres):
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost/healthcare_db
